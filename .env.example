# BTC-Edge environment variables. Copy to `.env` and fill in real values.
# NEVER commit a `.env` containing live keys.

# ---- Trading safety (PAPER-FIRST) ----
# Leave unset (or "FALSE") to stay in paper mode. Live routing requires BOTH:
#   config/config.yaml  trading.mode == "live"  AND  ALLOW_LIVE_TRADING == "TRUE"
ALLOW_LIVE_TRADING=FALSE

# ---- Gusto mode (keyword-gated aggressive Polymarket recovery) ----
# The secret word an operator must type in the Polymarket wallet panel to arm
# "gusto" recovery betting (full-Kelly, uncapped). Leave EMPTY to disable the
# mode entirely (it can never be armed). Auto-disarms after the timeout.
GUSTO_MODE_KEYWORD=
GUSTO_MODE_TIMEOUT_SECONDS=900

# ---- Dashboard auth (REQUIRED in production) ----
# Protects the dashboard, kill switch, and AI assistant from anyone who finds
# the URL. Set a long random value; the web UI will prompt for it.
DASHBOARD_API_KEY=

# ---- Kalshi ----
KALSHI_API_KEY_ID=
# Either Ed25519 or RSA private key (PEM or base64), per your Kalshi profile.
KALSHI_PRIVATE_KEY=
KALSHI_ACCESS_KEY_ID=
KALSHI_ACCESS_KEY=
# true -> use the demo host (https://external-api.demo.kalshi.co/trade-api/v2)
KALSHI_USE_DEMO=true

# ---- Polymarket US (polymarket.us) ----
# Key ID + Secret Key from polymarket.us/developer (NOT an EVM private key —
# polymarket.us is a hosted-wallet exchange, unlike polymarket.com).
POLYMARKET_API_KEY_ID=
POLYMARKET_API_SECRET=

# ---- Deribit (public IV/DVOL; optional) ----
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# ---- AI assistant (read-only explainer) ----
# OpenAI-compatible API. Works with OpenAI (ChatGPT) or DeepSeek.
#   ChatGPT:  AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
#   DeepSeek: AI_BASE_URL=https://api.deepseek.com/v1  AI_MODEL=deepseek-chat
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ---- Telegram alerts (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Operators (multi-key; armed via POST /api/btc-15m/operators/:id/arm) ----
# Readiness is reported as booleans only — keys are never exposed in responses.
OP1_KALSHI_KEY_ID=
OP1_POLY_WALLET=
OP2_KALSHI_KEY_ID=
OP2_POLY_WALLET=

# ---- Engine ----
BTC_EDGE_CONFIG_PATH=config/config.yaml
BTC_EDGE_DB_PATH=data/btc_edge.db
BTC_EDGE_LOG_LEVEL=INFO
