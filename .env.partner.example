# BTC-Edge environment variables for Partner (User 2).
# NEVER commit this file (it is gitignored).

# ---- Trading safety (PAPER-FIRST) ----
ALLOW_LIVE_TRADING=FALSE

# ---- Dashboard auth (REQUIRED in production) ----
DASHBOARD_API_KEY=partnerkey

# ---- Kalshi ----
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
KALSHI_ACCESS_KEY_ID=
KALSHI_ACCESS_KEY=
KALSHI_USE_DEMO=true

# ---- Polymarket ----
POLYMARKET_WALLET=
POLYMARKET_PRIVATE_KEY=

# ---- AI assistant (read-only explainer) ----
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ---- Telegram alerts (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Engine ----
BTC_EDGE_CONFIG_PATH=config/config.yaml
BTC_EDGE_DB_PATH=data/btc_edge_partner.db
BTC_EDGE_LOG_LEVEL=INFO
